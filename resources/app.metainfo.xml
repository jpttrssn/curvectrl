  <url type="bugtracker">https://github.com/jpttrssn/curvectrl</url>
  <name>CurveCtrl</name>
  <summary>A keyboard-centric film negative RAW image editor</summary>
  <description>
    <p>A keyboard-centric film roll library and non-destructive RAW editor focused on digital camera scans of black and white film rolls.</p>
    <ul>
      <li>Manage your film rolls</li>
      <li>Film inversion presets</li>
      <li>Auto inversion per frame or choosen frame</li>
      <li>Basic tone curve adjustments</li>
      <li>Crop mode tuned for removing edges</li>
      <li>Set and export original roll date with chronological frame order</li>
      <li>Search by roll name or date</li>
    </ul>
  </description>
  <icon type="remote" width="64" height="64" scale="1">
